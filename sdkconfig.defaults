# lastDSMRlogger - default SDK configuration
# Date: 2026-11-16 · Build: 2

# Hardware target: ESP32-S3 on the TFT LCD Display EC11 Piggyback Board v3.
CONFIG_IDF_TARGET="esp32s3"

# The module on the piggyback board carries 8 MB of SPI flash (the boot
# probe reports a GD 8 MB chip; a 16 MB image header panics the boot-time
# size check) and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The console runs on the native USB serial/JTAG peripheral, so UART0
# (GPIO43/44) is completely free for the P1 receiver: RX on the configured
# gpio and TX on GPIO43 for the forwarded telegrams.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The SPA exchanges its dynamic data with the device over a WebSocket; the
# esp_http_server WebSocket support must be compiled in.
CONFIG_HTTPD_WS_SUPPORT=y

# The module also carries an 8 MB octal PSRAM chip: enable it at boot so the
# receiver can carve its large telegram buffers (retained history, staging
# record, parser workspace) from external RAM. CAPS_ALLOC keeps plain
# malloc() on the internal heap; only the explicit heap_caps_malloc() calls
# of the receiver target PSRAM. IGNORE_NOTFOUND keeps the firmware booting
# on a module without PSRAM; the receiver then falls back to internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# With 16 MB of flash the custom table offers two generous OTA app slots;
# the nvs partition stays at its original address so stored settings
# survive. See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The SPA assets are embedded in the firmware image.
